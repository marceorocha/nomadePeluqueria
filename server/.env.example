# Database
DATABASE_URL="postgresql://user:password@localhost:5432/nomade?schema=public"

# Supabase project URL (used to verify Supabase Auth JWTs)
# Example: https://your-project-ref.supabase.co
SUPABASE_URL=
# Emails permitidos para administración (separados por coma)
# ADMIN_EMAILS=admin@nomade.com,owner@nomade.com

# JWT (admin + client auth)
JWT_SECRET="your-super-secret-key-change-in-production"

# Optional: email (Nodemailer / Resend)
# SMTP_HOST=...
# SMTP_PORT=587
# RESEND_API_KEY=...

# Optional: SMS (Twilio)
# TWILIO_ACCOUNT_SID=...
# TWILIO_AUTH_TOKEN=...
# TWILIO_PHONE_NUMBER=...

# Google Calendar (OAuth2) — required for Google sync
# Create credentials at https://console.cloud.google.com/apis/credentials
# Enable Google Calendar API and set redirect URI to: {API_BASE_URL}/api/admin/calendar/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/admin/calendar/google/callback

# Base URL of this API (for OAuth redirect); default http://localhost:3001
# API_BASE_URL=http://localhost:3001

# CalDAV (iCloud): use Apple ID + app-specific password from https://appleid.apple.com
# CALDAV_URL=https://caldav.icloud.com
# CALDAV_USERNAME=  (Apple ID email)
# CALDAV_PASSWORD=  (app-specific password)
