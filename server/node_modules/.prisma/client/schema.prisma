// Nomade — Aesthetic Clinic & Hair Salon
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ClientTier {
  REGULAR
  SILVER
  GOLD
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum SlotTierRequired {
  GOLD
}

model Client {
  id         String     @id @default(cuid())
  name       String
  email      String     @unique
  phone      String
  sex        String?
  birthday   DateTime?  @db.Date
  tier       ClientTier @default(REGULAR)
  visitCount Int        @default(0)
  createdAt  DateTime   @default(now())

  appointments  Appointment[]
  notifications Notification[]

  @@map("clients")
}

model Staff {
  id    String @id @default(cuid())
  name  String
  email String @unique
  role  String

  services     Service[]
  appointments Appointment[]
  workingHours WorkingHours[]
  blockedSlots BlockedSlot[]

  @@map("staff")
}

model Service {
  id              String  @id @default(cuid())
  name            String
  durationMinutes Int
  bufferMinutes   Int     @default(0)
  price           Decimal @db.Decimal(10, 2)
  staffId         String

  staff        Staff         @relation(fields: [staffId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@map("services")
}

model Appointment {
  id            String            @id @default(cuid())
  clientId      String
  serviceId     String
  staffId       String
  startTime     DateTime
  endTime       DateTime
  status        AppointmentStatus @default(PENDING)
  notes         String?
  googleEventId String?
  caldavEventId String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, startTime, endTime])
  @@index([clientId])
  @@map("appointments")
}

model WorkingHours {
  id        String @id @default(cuid())
  staffId   String
  dayOfWeek Int // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  startTime String // e.g. "09:00"
  endTime   String // e.g. "18:00"

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, dayOfWeek])
  @@map("working_hours")
}

model BlockedSlot {
  id           String            @id @default(cuid())
  staffId      String
  startTime    DateTime
  endTime      DateTime
  reason       String?
  tierRequired SlotTierRequired? // null = blocked for everyone; GOLD = Gold-only slot

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, startTime, endTime])
  @@map("blocked_slots")
}

model Notification {
  id       String   @id @default(cuid())
  clientId String
  type     String // e.g. BOOKING_CONFIRMATION, REMINDER_24H, BIRTHDAY_DISCOUNT
  sentAt   DateTime @default(now())
  status   String   @default("SENT") // SENT, FAILED, PENDING

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("notifications")
}

enum CalendarProvider {
  GOOGLE
  CALDAV
}

model CalendarConnection {
  id        String           @id @default(cuid())
  provider  CalendarProvider @unique
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  // Google OAuth2: stored after callback
  googleRefreshToken String?
  googleAccessToken  String?
  googleExpiryDate   DateTime?

  // CalDAV (iCloud): url, username, app-specific password
  caldavUrl      String?
  caldavUsername String?
  caldavPassword String?

  @@map("calendar_connections")
}
