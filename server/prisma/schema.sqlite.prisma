// Nomade — SQLite schema (use this to run without PostgreSQL)
// Usage: npm run db:sqlite:push  (from repo root)
// Set in server/.env: DATABASE_URL="file:./dev.db"

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ClientTier {
  REGULAR
  SILVER
  GOLD
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum SlotTierRequired {
  GOLD
}

model Client {
  id         String     @id @default(cuid())
  name       String
  email      String     @unique
  phone      String
  birthday   DateTime?
  tier       ClientTier  @default(REGULAR)
  visitCount Int         @default(0)
  createdAt  DateTime    @default(now())

  appointments   Appointment[]
  notifications  Notification[]
}

model Staff {
  id    String @id @default(cuid())
  name  String
  email String @unique
  role  String

  services     Service[]
  appointments Appointment[]
  workingHours WorkingHours[]
  blockedSlots BlockedSlot[]
}

model Service {
  id              String   @id @default(cuid())
  name            String
  durationMinutes Int
  bufferMinutes   Int      @default(0)
  price           Float
  staffId         String

  staff        Staff         @relation(fields: [staffId], references: [id], onDelete: Cascade)
  appointments Appointment[]
}

model Appointment {
  id             String            @id @default(cuid())
  clientId       String
  serviceId      String
  staffId        String
  startTime      DateTime
  endTime        DateTime
  status         AppointmentStatus @default(PENDING)
  notes          String?
  googleEventId  String?
  caldavEventId  String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, startTime, endTime])
  @@index([clientId])
}

model WorkingHours {
  id        String   @id @default(cuid())
  staffId   String
  dayOfWeek Int
  startTime String
  endTime   String

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, dayOfWeek])
}

model BlockedSlot {
  id           String   @id @default(cuid())
  staffId      String
  startTime    DateTime
  endTime      DateTime
  reason       String?
  tierRequired SlotTierRequired?

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, startTime, endTime])
}

model Notification {
  id        String   @id @default(cuid())
  clientId  String
  type      String
  sentAt    DateTime @default(now())
  status    String   @default("SENT")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

enum CalendarProvider {
  GOOGLE
  CALDAV
}

model CalendarConnection {
  id        String           @id @default(cuid())
  provider  CalendarProvider @unique
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  googleRefreshToken String?
  googleAccessToken  String?
  googleExpiryDate   DateTime?

  caldavUrl      String?
  caldavUsername String?
  caldavPassword String?
}
